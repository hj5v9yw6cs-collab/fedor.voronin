# Personal cabinet (student login) — powered by Supabase. Copy this file
# to `.env` and fill in the two values from your Supabase project
# (Settings → API). See README.md "Личный кабинет" for the full setup.
# The site works fine without these — the cabinet just shows a
# "not configured yet" message instead.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
